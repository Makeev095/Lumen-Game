; Engine configuration file.

config_version=5

[application]

config/name="Lumen"
config/description="Ночная оранжерея, три в ряд."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.031, 0.067, 0.051, 1)
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/event_bus.gd"
Locale="*res://scripts/locale.gd"
Yandex="*res://scripts/yandex_bridge.gd"
Sound="*res://scripts/sound.gd"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=0
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

environment/defaults/default_clear_color=Color(0.031, 0.067, 0.051, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
